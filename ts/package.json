{
  "name": "agent-service",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript port of agent-service (meta#103, decision 23). Lives next to the Go service until the cutover.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "codegen": "node scripts/codegen.js",
    "build": "node scripts/codegen.js && tsc -p tsconfig.build.json",
    "typecheck": "node scripts/codegen.js && tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "openapi": "node scripts/codegen.js && node scripts/write-openapi.js",
    "check:deps": "node scripts/check-dependencies.js",
    "pretest": "node scripts/codegen.js",
    "test": "jest"
  },
  "dependencies": {
    "@tsoa/runtime": "^6.6.0",
    "@v-m-pioneer-trading/clerk-client": "https://github.com/V-M-Pioneer-Trading/clerk-client/releases/download/v2.0.0/v-m-pioneer-trading-clerk-client-2.0.0.tgz",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "jest": "^30.5.2",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "tsoa": "^6.6.0",
    "typescript": "^7.0.2"
  }
}
